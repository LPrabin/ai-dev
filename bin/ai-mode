#!/usr/bin/env bash
# ai-mode — switch between Work and Self modes
# Single vault with folder-based separation
#
# Usage:
#   ai-mode                    # show current mode + status
#   ai-mode work               # switch to work mode
#   ai-mode self               # switch to self mode
#   ai-mode --init             # create vault directories
#   ai-mode --list             # list all projects/topics
#
# Env vars (set in ~/.zshrc):
#   AI_MODE                    # "work" or "self"
#   OBSIDIAN_VAULT             # path to single vault

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=obs-lib
source "${SCRIPT_DIR}/obs-lib"

# Mode switching paths
AI_HOME="${AI_HOME:-$HOME/.ai}"
CONTEXT_DIR="${AI_HOME}/context"
MODES_DIR="${AI_HOME}/modes"

switch_mode() {
  local mode="$1"
  local mode_dir="${MODES_DIR}/${mode}"
  
  if [[ ! -d "$mode_dir" ]]; then
    echo "[ai-mode] error: mode directory not found: ${mode_dir}" >&2
    echo "Run: ai-mode --init-modes" >&2
    return 1
  fi
  
  # Remove existing symlink or backup directory
  if [[ -L "$CONTEXT_DIR" ]]; then
    rm "$CONTEXT_DIR"
  elif [[ -d "$CONTEXT_DIR" ]]; then
    echo "[ai-mode] warning: ${CONTEXT_DIR} is a directory, backing up to ${CONTEXT_DIR}.bak.$(date +%s)"
    mv "$CONTEXT_DIR" "${CONTEXT_DIR}.bak.$(date +%s)"
  fi
  
  # Create symlink
  if ! ln -s "$mode_dir" "$CONTEXT_DIR"; then
    echo "[ai-mode] error: failed to create symlink" >&2
    return 1
  fi
  
  # Update shell env
  export AI_MODE="$mode"
  
  # Rebuild context for all tools
  local build_script="${AI_HOME}/bin/build-context"
  if [[ -x "$build_script" ]]; then
    "$build_script" 2>/dev/null || true
  fi
  
  # Redistribute MCP servers
  local mcp_script
  mcp_script="$(dirname "${BASH_SOURCE[0]}")/ai-mcp"
  if [[ -x "$mcp_script" ]]; then
    "$mcp_script" distribute all 2>/dev/null || true
  fi
  
  # Log to Obsidian (if available)
  if obs_vault_set || obs_cli_available; then
    local log_entry="- [$(date '+%Y-%m-%d %H:%M')] Mode switch: ${mode}"
    obs_write_note "$(obs_session_note)" "$log_entry" 2>/dev/null || true
  fi
  
  echo "[ai-mode] Switched to: ${mode}"
  echo "  Context: ${CONTEXT_DIR} -> ${mode_dir}"
}

show_status() {
  echo "ai-dev status"
  echo "─────────────────────────────────────"
  echo "  Mode:      ${OBS_MODE}"
  echo "  Project:   ${OBS_PROJECT}"
  echo "  Vault:     ${OBS_VAULT:-<not set>}"
  echo ""

  # Transport
  local transport="none"
  if obs_cli_available; then
    transport="Obsidian CLI"
  elif obs_vault_set; then
    transport="filesystem"
  fi
  echo "  Transport: ${transport}"
  echo ""

  # Show context symlink status
  if [[ -L "$CONTEXT_DIR" ]]; then
    local target
    target=$(readlink "$CONTEXT_DIR")
    echo "  Context:   ${CONTEXT_DIR} -> ${target}"
  elif [[ -d "$CONTEXT_DIR" ]]; then
    echo "  Context:   ${CONTEXT_DIR} (directory, not symlinked)"
  else
    echo "  Context:   ${CONTEXT_DIR} (not found)"
  fi
  echo ""

  # Show current project/topic status (filesystem only for speed)
  if obs_vault_set; then
    local session_file
    session_file="${OBS_VAULT}/$(obs_session_note)"
    if [[ -f "$session_file" ]]; then
      echo "  Session tasks:"
      grep -E "^\s*- \[" "$session_file" 2>/dev/null | head -5 | sed 's/^/    /' || echo "    (none)"
    else
      echo "  (no active session — run: obs-write --init)"
    fi
  fi
  echo ""
}

list_all() {
  echo "=== Projects (Work) ==="
  if obs_vault_set && [[ -d "${OBS_VAULT}/Work/Projects" ]]; then
    for d in "${OBS_VAULT}/Work/Projects/"*/; do
      [[ -d "$d" ]] || continue
      local name
      name=$(basename "$d")
      local session="${d}Session.md"
      local tasks=""
      if [[ -f "$session" ]]; then
        tasks=$(grep -c "- \[ \]" "$session" 2>/dev/null || echo "0")
        tasks=" (${tasks} open tasks)"
      fi
      echo "  ${name}${tasks}"
    done
  else
    echo "  (none)"
  fi
  echo ""

  echo "=== Topics (Self) ==="
  if obs_vault_set && [[ -d "${OBS_VAULT}/Self/Topics" ]]; then
    for d in "${OBS_VAULT}/Self/Topics/"*/; do
      [[ -d "$d" ]] || continue
      local name
      name=$(basename "$d")
      echo "  ${name}"
    done
  else
    echo "  (none)"
  fi
}

init_vault() {
  if ! obs_vault_set; then
    echo "ERROR: OBSIDIAN_VAULT not set" >&2
    echo "Add to ~/.zshrc:"
    echo '  export OBSIDIAN_VAULT="$HOME/Documents/Brain"'
    return 1
  fi

  echo "Initializing vault: ${OBS_VAULT}"
  echo ""

  # Single vault, two top-level folders
  mkdir -p "${OBS_VAULT}/Work/Projects"
  mkdir -p "${OBS_VAULT}/Self/Topics"
  mkdir -p "${OBS_VAULT}/Library/Decisions"
  mkdir -p "${OBS_VAULT}/Library/Skills"
  mkdir -p "${OBS_VAULT}/Library/Errors"

  echo "Created:"
  echo "  ${OBS_VAULT}/Work/Projects/   — project-based work"
  echo "  ${OBS_VAULT}/Self/Topics/     — learning & exploration"
  echo "  ${OBS_VAULT}/Library/         — cross-cutting knowledge"
  echo ""
  echo "Vault initialized. One vault, two modes, full cross-linking."
}

case "${1:-}" in
  work)
    switch_mode "work"
    ;;
  self)
    switch_mode "self"
    ;;
  --init-modes)
    echo "Creating mode directories..."
    mkdir -p "${MODES_DIR}/work/rules"
    mkdir -p "${MODES_DIR}/self/rules"
    echo "Created: ${MODES_DIR}/work/"
    echo "Created: ${MODES_DIR}/self/"
    echo ""
    echo "Next: Add identity.md and tools.md to each mode directory"
    ;;
  -i|--init)
    init_vault
    ;;
  -l|--list)
    list_all
    ;;
  "")
    show_status
    ;;
  -h|--help)
    echo "Usage: ai-mode [work|self|--init|--init-modes|--list]"
    echo "  (no args)     show current status"
    echo "  work          switch to work mode (symlinks context)"
    echo "  self          switch to self mode (symlinks context)"
    echo "  --init        create vault directories"
    echo "  --init-modes  create mode directories in ~/.ai/modes/"
    echo "  --list        list all projects and topics"
    ;;
  *)
    echo "Unknown mode: $1 (use 'work' or 'self')" >&2
    exit 1
    ;;
esac
