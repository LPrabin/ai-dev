#!/usr/bin/env bash
# ai-start — begin an AI dev session
# Chains: mode check -> obs-read -> build-context -> show status
#
# Usage:
#   ai-start                  # start session in current mode
#   ai-start work             # switch to work mode and start
#   ai-start self             # switch to self mode and start
#   ai-start --rebuild        # also rebuild context and push to all tools
#
# This is the single command you run at the start of every session.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=obs-lib
source "${SCRIPT_DIR}/obs-lib"

REBUILD=false

# Parse args
while [[ $# -gt 0 ]]; do
  case "$1" in
    work)      export AI_MODE="work"; OBS_MODE="work" ;;
    self)      export AI_MODE="self"; OBS_MODE="self" ;;
    --rebuild) REBUILD=true ;;
    -h|--help)
      echo "Usage: ai-start [work|self] [--rebuild]"
      echo "  (no args)   start session in current mode"
      echo "  work/self   switch mode and start"
      echo "  --rebuild   also run build-context --obsidian --adapter all"
      exit 0
      ;;
    *) echo "Unknown arg: $1" >&2; exit 1 ;;
  esac
  shift
done

echo "╔══════════════════════════════════════╗"
echo "║         ai-dev session start         ║"
echo "╚══════════════════════════════════════╝"
echo ""

# ── Mode ────────────────────────────────────────────────────────────────────
echo "Mode:    ${OBS_MODE}"
echo "Project: ${OBS_PROJECT}"
echo "Path:    $(obs_base_path)"

# Transport
if obs_cli_available; then
  echo "CLI:     Obsidian CLI available"
elif obs_vault_set; then
  echo "CLI:     not found (using filesystem)"
else
  echo "CLI:     not found, vault not set"
fi
echo ""

# ── Pull context ────────────────────────────────────────────────────────────
echo "── Session Context ──────────────────────"
echo ""

# Show session tasks
SESSION=$(obs_read_note "$(obs_session_note)")
if [[ -n "$SESSION" ]]; then
  echo "$SESSION"
else
  echo "(No session found — run: obs-write --init)"
fi
echo ""

# Show open tasks count
if [[ -n "$SESSION" ]]; then
  OPEN=$(echo "$SESSION" | grep -c "- \[ \]" || true)
  DONE=$(echo "$SESSION" | grep -c "- \[x\]" || true)
  echo "Tasks: ${OPEN} open, ${DONE} done"
  echo ""
fi

# Show recent decisions (last 3)
echo "── Recent Decisions ────────────────────"
DECISIONS=$(obs_read_note "$(obs_decisions_dir)/log.md")
if [[ -n "$DECISIONS" ]]; then
  echo "$DECISIONS" | tail -5
else
  echo "(none yet)"
fi
echo ""

# ── Daily note integration ──────────────────────────────────────────────────
if obs_cli_available; then
  echo "── Today's Daily Note ──────────────────"
  DAILY=$(obs_daily_read 2>/dev/null)
  if [[ -n "$DAILY" ]] && [[ "$DAILY" != "(no daily note)" ]]; then
    echo "$DAILY" | head -10
  else
    echo "(no daily note)"
  fi
  echo ""
fi

# ── Rebuild context ─────────────────────────────────────────────────────────
if [[ "$REBUILD" == true ]]; then
  echo "── Rebuilding Context ──────────────────"
  "${SCRIPT_DIR}/build-context" --obsidian --adapter all
  echo ""
fi

# ── Ready ───────────────────────────────────────────────────────────────────
echo "────────────────────────────────────────"
echo "Ready. Commands:"
echo "  obs-read --all             full context"
echo "  obs-write --decision TEXT  log a decision"
echo "  obs-write --fix TEXT       log a bug fix"
echo "  obs-write --skill TEXT     log a pattern"
echo "  obs-search --cross QUERY   search across Work + Self"
echo "  obs-write                  end-of-session log"
echo "────────────────────────────────────────"
